[Unit]
Description=Laya local shadow decision service (Jev-compatible, 127.0.0.1:8790)
Documentation=file:%h/projects/auraforge-semantic-control/docs/laya-serve.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/auraforge-semantic-control
Environment=NODE_ENV=production
Environment=LAYA_SERVE_HOST=127.0.0.1
Environment=LAYA_SERVE_PORT=8790
Environment=LAYA_SERVE_MODEL_DIR=/opt/auraforge/models/laya/base-fp32
Environment=LAYA_SERVE_HASH_WEIGHTS=1
Environment=LAYA_SERVE_REQUIRE_SHADOW=0
# Device policy (Raja 2026-09-29). fp32 is ~1.6 GiB and adds ~2337 MiB of GPU
# memory, over the hard 2048 MiB ceiling, so it must stay on CPU. To move Laya to
# the RTX PRO 4000: build a quantized bundle under ~/models/laya/<variant>/,
# point LAYA_SERVE_MODEL_DIR at it and set LAYA_SERVE_DEVICE=cuda. A CUDA init
# failure falls back to CPU automatically; the service never blanks the GPU.
Environment=LAYA_SERVE_DEVICE=cpu
Environment=LAYA_SERVE_GPU_MEM_MB=2048
Environment=LAYA_SERVE_GPU_DEVICE_ID=0

ExecStart=/usr/bin/node %h/projects/auraforge-semantic-control/dist/serve/index.js

Restart=on-failure
RestartSec=3

# The fp32 ModernBERT-large bundle peaks near 2 GB RSS; bound it below the box.
MemoryMax=3G
Nice=10

# Least privilege for a loopback-only, read-only service. The shadow log lives
# under the user's home and remains writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
