{
  "name": "@receptron/laya",
  "version": "0.1.2",
  "description": "Run Laya (convaiinnovations/laya), the open-source Jev-compatible System-1 decision model, from Node.js / TypeScript via ONNX Runtime",
  "license": "MIT",
  "author": "receptron",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/laya.git"
  },
  "homepage": "https://github.com/receptron/laya#readme",
  "bugs": {
    "url": "https://github.com/receptron/laya/issues"
  },
  "keywords": [
    "laya",
    "jev",
    "system-one",
    "decision-model",
    "onnx",
    "onnxruntime",
    "modernbert",
    "classification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "tsx --test test/test_download.ts test/test_model.ts test/test_sequence.ts test/test_serve_protocol.ts test/test_serve_device.ts test/test_serve_shadow.ts test/test_serve_http.ts test/test_serve_jev_tap.ts",
    "test:serve": "tsx --test test/test_serve_protocol.ts test/test_serve_device.ts test/test_serve_shadow.ts test/test_serve_http.ts test/test_serve_jev_tap.ts",
    "test:device": "tsx --test test/test_serve_device.ts",
    "test:jev-tap": "tsx --test test/test_serve_jev_tap.ts",
    "serve": "tsx src/serve/index.ts",
    "bench:latency": "tsx scripts/bench-latency.ts",
    "check:parity": "tsx scripts/check-parity.ts",
    "calibrate:fixtures": "tsx scripts/calibration-fixtures.ts",
    "format": "prettier --write \"{src,test,examples,scripts}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,examples,scripts}/**/*.ts\" \"*.{json,md}\"",
    "example": "tsx examples/basic.ts",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-sonarjs": "^4",
    "globals": "^17",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}
